#olist database settings
DATABASE_HOST=db
DATABASE_NAME=your_database_name
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_PORT=5432

#Airflow database settings
AIRFLOW_DB_USER=your_airflow_database_user
AIRFLOW_DB_PASSWORD=your_airflow_database_password
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_HOST=airflow-db

#Airflow secrets
FERNET_KEY=your_fernet_key
AIRFLOW__API__AUTH__JWT_SECRET=your_jwt_secret

#for Airflow DAGs
PROJECT_ROOT=your_project_absolute_path